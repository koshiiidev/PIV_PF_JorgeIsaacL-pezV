@model PIV_PF_JorgeIsaacLópezV.Models.ViewModels.Cliente
@{
    ViewBag.Title = "Detalles del Cliente";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-user"></i> Detalles del Cliente
                        </h4>
                        <span class="badge badge-light">
                            ID: @Model.Id_Usuario
                        </span>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        
                        <div class="col-md-8">
                            <h5 class="text-primary mb-4">
                                <i class="fas fa-info-circle"></i> Información Personal
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong class="text-muted">Identificación:</strong>
                                </div>
                                <div class="col-md-8">
                                    <span class="h6 text-dark">@Model.Identificacion</span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong class="text-muted">Nombre Completo:</strong>
                                </div>
                                <div class="col-md-8">
                                    <span class="h6 text-dark">@Model.NombreCompleto</span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong class="text-muted">Correo Electrónico:</strong>
                                </div>
                                <div class="col-md-8">
                                    <a href="mailto:@Model.Correo" class="text-decoration-none">
                                        <i class="fas fa-envelope text-primary"></i>
                                        @Model.Correo
                                    </a>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong class="text-muted">Estado:</strong>
                                </div>
                                <div class="col-md-8">
                                    <span class="badge @(Model.EstadoDescripcion == "Activo" ? "badge-success" : "badge-secondary") badge-pill">
                                        @Model.EstadoDescripcion
                                    </span>
                                </div>
                            </div>
                        </div>

                        
                        <div class="col-md-4">
                            <div class="card bg-light border-0">
                                <div class="card-body text-center">
                                    <div class="mb-3">
                                        @if (Model.EstadoDescripcion == "Activo")
                                        {
                                            <i class="fas fa-user-check fa-3x text-success"></i>
                                            <h6 class="text-success mt-2">Cliente Activo</h6>
                                            <small class="text-muted">Este cliente puede realizar compras</small>
                                        }
                                        else
                                        {
                                            <i class="fas fa-user-times fa-3x text-secondary"></i>
                                            <h6 class="text-secondary mt-2">Cliente Inactivo</h6>
                                            <small class="text-muted">Este cliente no puede realizar compras</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    
                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-muted mb-3">
                                <i class="fas fa-clipboard-list"></i> Información del Sistema
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-tag text-info mr-2"></i>
                                        <small class="text-muted">Tipo de Usuario: <strong>Cliente</strong></small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-database text-info mr-2"></i>
                                        <small class="text-muted">ID Sistema: <strong>@Model.Id_Usuario</strong></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            @Html.ActionLink("Editar Cliente", "EditarCliente",
                                new { id = Model.Id_Usuario },
                                new { @class = "btn btn-warning" })

                            @Html.ActionLink("Volver a la Lista", "Index", null,
                                new { @class = "btn btn-secondary ml-2" })
                        </div>

                        <div class="text-right">
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt"></i>
                                Consultado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <i class="fas fa-edit fa-2x text-info mb-2"></i>
                            <h6>Editar Información</h6>
                            <p class="text-muted small">Actualizar nombre y correo del cliente</p>
                            @Html.ActionLink("Editar", "EditarCliente",
                                new { id = Model.Id_Usuario },
                                new { @class = "btn btn-outline-info btn-sm" })
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <i class="fas fa-envelope fa-2x text-primary mb-2"></i>
                            <h6>Contactar Cliente</h6>
                            <p class="text-muted small">Enviar correo electrónico</p>
                            <a href="mailto:@Model.Correo" class="btn btn-outline-primary btn-sm">
                                Enviar Email
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <i class="fas fa-list fa-2x text-success mb-2"></i>
                            <h6>Ver Todos</h6>
                            <p class="text-muted small">Volver a la lista de clientes</p>
                            @Html.ActionLink("Lista Completa", "Index", null,
                                new { @class = "btn btn-outline-success btn-sm" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            
            $('.card').hover(
                function() {
                    $(this).addClass('shadow-lg').css('transition', 'all 0.3s ease');
                },
                function() {
                    $(this).removeClass('shadow-lg');
                }
            );

            
            $('[data-toggle="tooltip"]').tooltip();

            
            $('.card').hide().fadeIn(800);

            
            $('a[href^="mailto:"]').on('click', function(e) {
                var email = $(this).text().trim();

                
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(email).then(function() {
                        
                        showNotification('Correo copiado al portapapeles', 'success');
                    }).catch(function() {
                        
                        prompt('Correo del cliente:', email);
                    });
                }
            });

            
            function showNotification(message, type) {
                var alertClass = type === 'success' ? 'alert-success' : 'alert-info';
                var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed" style="top: 20px; right: 20px; z-index: 1050;">' +
                    '<button type="button" class="close" data-dismiss="alert">' +
                    '<span>&times;</span>' +
                    '</button>' +
                    message +
                    '</div>');

                $('body').append(notification);

                setTimeout(function() {
                    notification.fadeOut(function() {
                        $(this).remove();
                    });
                }, 3000);
            }
        });
    </script>
}