@model PIV_PF_JorgeIsaacLópezV.Models.ViewModels.ListaClientes

@{
    ViewBag.Title = "Gestión de Clientes";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>Gestión de Clientes</h2>

            @* Mostrar mensajes *@
            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                string alertClass = Model.TipoMensaje == "success" ? "alert-success" :
                                  Model.TipoMensaje == "error" ? "alert-danger" : "alert-info";

                <div class="alert @alertClass alert-dismissible fade show" role="alert">
                    @Model.Mensaje
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Lista de Clientes</h5>
                    @Html.ActionLink("Registrar Nuevo Cliente", "CrearCliente", null,
                        new { @class = "btn btn-primary" })
                </div>

                <div class="card-body">
                    @if (Model.Clientes != null && Model.Clientes.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Identificación</th>
                                        <th>Nombre Completo</th>
                                        <th>Correo Electrónico</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cliente in Model.Clientes)
                                    {
                                        <tr>
                                            <td>@cliente.Identificacion</td>
                                            <td>@cliente.NombreCompleto</td>
                                            <td>@cliente.Correo</td>
                                            <td>
                                                <span class="badge @(cliente.EstadoDescripcion == "Activo" ? "badge-success" : "badge-secondary")">
                                                    @cliente.EstadoDescripcion
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Ver", "DetallesCliente",
                                                        new { id = cliente.Id_Usuario },
                                                        new { @class = "btn btn-info btn-sm", title = "Ver detalles" })
                                                    @Html.ActionLink("Editar", "EditarCliente",
                                                        new { id = cliente.Id_Usuario },
                                                        new { @class = "btn btn-warning btn-sm", title = "Editar cliente" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i>
                            No hay clientes registrados en el sistema.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-ocultar alertas después de 5 segundos
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}