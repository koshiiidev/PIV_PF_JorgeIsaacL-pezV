<!-- Acciones Principales -->
<div class="row">
    <div class="col-md-6">
        <div class="action-card users fade-in-up">
            <div class="action-icon">
                <i class="fa fa-users"></i>
            </div>
            <h4>Gestión de Usuarios</h4>
            <p>Administra los usuarios del sistema, crea nuevos perfiles y gestiona roles y permisos de acceso.</p>
            <a href="@Url.Action("Index", "Usuarios")" class="btn-action">
                <i class="fa fa-cog"></i> Gestionar Usuarios
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="action-card clients fade-in-up">
            <div class="action-icon">
                <i class="fa fa-user-circle"></i>
            </div>
            <h4>Agregar Usuarios</h4>
            <p>Registra  a nuevos usuarios y clientes</p>
            <a href="@Url.Action("CrearUsuario", "Usuarios")" class="btn-action success">
                <i class="fa fa-plus"></i> Agregar Usuarios
            </a>
        </div>
    </div>
</div>

<!-- Información del Sistema -->
<div class="row" style="margin-top: 30px;">
    <div class="col-md-12">
        <div class="stats-card fade-in-up">
            <div class="row">
                <div class="col-md-8">
                    <div class="card-icon" style="float: left; margin-right: 20px;">
                        <i class="fa fa-info-circle"></i>
                    </div>
                    <div style="overflow: hidden;">
                        <h3>Estado del Sistema</h3>
                        <p class="card-description">
                            El sistema está funcionando correctamente. Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <small class="text-muted">
                            <i class="fa fa-calendar"></i> Fecha actual: @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
                        </small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-right">
                        <div style="margin-bottom: 10px;">
                            <span class="label" style="background-color: var(--success-color); color: white; padding: 5px 10px; border-radius: 15px; font-size: 0.9em;">
                                <i class="fa fa-check"></i> Sistema Activo
                            </span>
                        </div>
                        <div>
                            <small class="text-muted">
                                <i class="fa fa-server"></i> Servidor en línea<br>
                                <i class="fa fa-database"></i> Base de datos conectada
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

