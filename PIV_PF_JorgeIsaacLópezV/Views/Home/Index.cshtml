@{
    ViewBag.Title = "Dashboard";
}

<div class="welcome-section fade-in-up">
    <div class="row">
        <div class="col-md-8">
            <h3><i class="fa fa-user-md"></i> Bienvenido al Sistema La Farmacia</h3>
            <p class="lead">Panel de control administrativo para la gestión integral de usuarios y clientes del sistema farmacéutico.</p>
            @if (ViewBag.UsuarioLogueado != null)
            {
                <p><strong>Usuario:</strong> @ViewBag.UsuarioLogueado</p>
                if (ViewBag.RolUsuario != null)
                {
                    <span class="user-role">@ViewBag.RolUsuario</span>
                }
            }
        </div>
        <div class="col-md-4 text-right">
            <div class="welcome-icon">
                <i class="fa fa-heartbeat" style="font-size: 4em; color: var(--primary-color); opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row quick-stats fade-in-up">
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-users" style="font-size: 2em; color: var(--primary-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.TotalUsuarios</span>
            <span class="stat-label">Total Usuarios</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-user-circle" style="font-size: 2em; color: var(--secondary-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.TotalClientes</span>
            <span class="stat-label">Clientes</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-shield" style="font-size: 2em; color: var(--accent-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.TotalAdmins</span>
            <span class="stat-label">Administradores</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-check-circle" style="font-size: 2em; color: var(--success-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.UsuariosActivos</span>
            <span class="stat-label">Usuarios Activos</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="action-card users fade-in-up">
            <div class="action-icon">
                <i class="fa fa-users"></i>
            </div>
            <h4>Gestión de Usuarios</h4>
            <p>Administra los usuarios del sistema, crea nuevos perfiles y gestiona roles y permisos de acceso.</p>
            <a href="@Url.Action("Index", "Usuarios")" class="btn-action">
                <i class="fa fa-cog"></i> Gestionar Usuarios
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="action-card clients fade-in-up">
            <div class="action-icon">
                <i class="fa fa-user-circle"></i>
            </div>
            <h4>Gestion de Clientes</h4>
            <p>Administra los clientes, crea nuevos perfiles o edita la informacion de los clientes.</p>
            <a href="@Url.Action("Index", "Clientes")" class="btn-action clientes">
                <i class="fa fa-cog"></i> Gestionar Clientes
            </a>
        </div>
    </div>
</div>

<div class="row" style="margin-top: 30px;">
    <div class="col-md-12">
        <div class="stats-card fade-in-up">
            <div class="row">
                <div class="col-md-8">
                    <div class="card-icon" style="float: left; margin-right: 20px;">
                        <i class="fa fa-info-circle"></i>
                    </div>
                    <div style="overflow: hidden;">
                        <h3>Estado del Sistema</h3>
                        <p class="card-description">
                            El sistema está funcionando correctamente. Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <small class="text-muted">
                            <i class="fa fa-calendar"></i> Fecha actual: @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
                        </small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-right">
                        <div style="margin-bottom: 10px;">
                            <span class="label" style="background-color: var(--success-color); color: white; padding: 5px 10px; border-radius: 15px; font-size: 0.9em;">
                                <i class="fa fa-check"></i> Sistema Activo
                            </span>
                        </div>
                        <div>
                            <small class="text-muted">
                                <i class="fa fa-server"></i> Servidor en línea<br>
                                <i class="fa fa-database"></i> Base de datos conectada
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

