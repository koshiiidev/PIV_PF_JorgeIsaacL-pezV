@{
    ViewBag.Title = "Dashboard";
}

<!-- Sección de Bienvenida -->
<div class="welcome-section fade-in-up">
    <div class="row">
        <div class="col-md-8">
            <h3><i class="fa fa-user-md"></i> Bienvenido al Sistema La Farmacia</h3>
            <p class="lead">Panel de control administrativo para la gestión integral de usuarios y clientes del sistema farmacéutico.</p>
            @if (ViewBag.UsuarioLogueado != null)
            {
                <p><strong>Usuario:</strong> @ViewBag.UsuarioLogueado</p>
                if (ViewBag.RolUsuario != null)
                {
                    <span class="user-role">@ViewBag.RolUsuario</span>
                }
            }
        </div>
        <div class="col-md-4 text-right">
            <div class="welcome-icon">
                <i class="fa fa-heartbeat" style="font-size: 4em; color: var(--primary-color); opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Estadísticas Rápidas -->
<div class="row quick-stats fade-in-up">
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-users" style="font-size: 2em; color: var(--primary-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.TotalUsuarios</span>
            <span class="stat-label">Total Usuarios</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-user-circle" style="font-size: 2em; color: var(--secondary-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.TotalClientes</span>
            <span class="stat-label">Clientes</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-shield" style="font-size: 2em; color: var(--accent-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.TotalAdmins</span>
            <span class="stat-label">Administradores</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-item">
            <i class="fa fa-check-circle" style="font-size: 2em; color: var(--success-color); margin-bottom: 10px;"></i>
            <span class="stat-number">@ViewBag.UsuariosActivos</span>
            <span class="stat-label">Usuarios Activos</span>
        </div>
    </div>
</div>

