@model PIV_PF_JorgeIsaacLópezV.Models.ViewModels.Login
@{
    ViewBag.Title = "Login - La Farmacia";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            font-family: Arial, sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .login-card {
            background: #00A1FF;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }

        .tittle {

            text-align: center;
            margin-bottom: 0;
            
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .login-header h2 {
                color: #333;
                margin-bottom: 10px;
            }

        .form-control {
            padding: 12px 15px;
            border-radius: 8px;
            border: 2px solid #e1e1e1;
            margin-bottom: 15px;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            }

        .btn-login {
            background: rgba(255, 255, 255, 0.3);
            border: none;
            color: white;
            padding: 12px;
            border-radius: 8px;
            width: 100%;
            font-weight: bold;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                background: rgba(255, 255, 255, 1);
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            }

        .alert {
            border-radius: 8px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>



    <h2 class="tittle">La Farmacia</h2>
    <div class="login-card">

        <div class="login-header">

            <p class="text-muted">Acceso al Sistema</p>
        </div>

        @if (ViewBag.ValorMensaje != null && ViewBag.ValorMensaje == 0)
        {
            <div class="alert alert-danger">
                @ViewBag.MensajeProceso
            </div>
        }

        @using (Html.BeginForm("Ingresar", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(m => m.CorreoUsuario, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.CorreoUsuario, new
                {
                    @class = "form-control",
                    placeholder = "ejemplo@correo.com",
                    type = "email"
                })
                @Html.ValidationMessageFor(m => m.CorreoUsuario, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.IdentificacionUsuario, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.IdentificacionUsuario, new
                {
                    @class = "form-control",
                    placeholder = "12345678",
                    type = "number"
                })
                @Html.ValidationMessageFor(m => m.IdentificacionUsuario, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-login">
                Ingresar al Sistema
            </button>
        }

        <div class="text-center mt-3">
            <small class="text-muted">
                &copy; @DateTime.Now.Year La Farmacia. Todos los derechos reservados.
            </small>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>