@model PIV_PF_JorgeIsaacLópezV.Models.ViewModels.ListaUsuarios
@{
    ViewBag.Title = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="page-header">
                <h2>
                    <i class="fa fa-users"></i> Gestión de Usuarios
                    <small>Administración del sistema</small>
                </h2>
            </div>

            @* Mostrar mensajes *@
            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                <div class="alert alert-@(Model.TipoMensaje == "success" ? "success" : Model.TipoMensaje == "error" ? "danger" : Model.TipoMensaje == "warning" ? "warning" : "info") alert-dismissible" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <i class="fa fa-@(Model.TipoMensaje == "success" ? "check-circle" : Model.TipoMensaje == "error" ? "exclamation-circle" : Model.TipoMensaje == "warning" ? "exclamation-triangle" : "info-circle")"></i>
                    @Model.Mensaje
                </div>
            }

            <div class="panel panel-default">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-sm-6">
                            <h4 class="panel-title">
                                <i class="fa fa-list"></i> Lista de Usuarios
                            </h4>
                        </div>
                        <div class="col-sm-6 text-right">
                            @Html.ActionLink("Nuevo Usuario", "CrearUsuario", null, new { @class = "btn btn-success btn-sm" })
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    @if (Model.Usuarios != null && Model.Usuarios.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Identificación</th>
                                        <th>Nombre Completo</th>
                                        <th>Correo Electrónico</th>
                                        <th>Tipo de Usuario</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in Model.Usuarios)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@usuario.Identificacion</strong>
                                            </td>
                                            <td>@usuario.NombreCompleto</td>
                                            <td>
                                                <a href="mailto:@usuario.Correo">@usuario.Correo</a>
                                            </td>
                                            <td>
                                                <span class="label label-@(usuario.TipoUsuarioDescripcion == "Administrador" ? "danger" : usuario.TipoUsuarioDescripcion == "Vendedor" ? "primary" : "info")">
                                                    @usuario.TipoUsuarioDescripcion
                                                </span>
                                            </td>
                                            <td>
                                                <span class="label label-@(usuario.EstadoDescripcion == "Activo" ? "success" : "default")">
                                                    <i class="fa fa-@(usuario.EstadoDescripcion == "Activo" ? "check" : "ban")"></i>
                                                    @usuario.EstadoDescripcion
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @Html.ActionLink("Ver", "DetallesUsuario", new { id = usuario.Id_Usuario }, new { @class = "btn btn-info btn-xs", title = "Ver detalles" })
                                                    @Html.ActionLink("Editar", "EditarUsuario", new { id = usuario.Id_Usuario }, new { @class = "btn btn-warning btn-xs", title = "Editar usuario" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="alert alert-info">
                                    <i class="fa fa-info-circle"></i>
                                    <strong>Total de usuarios registrados:</strong> @Model.Usuarios.Count
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <h4><i class="fa fa-exclamation-triangle"></i> No hay usuarios registrados</h4>
                            <p>Aún no se han registrado usuarios en el sistema.</p>
                            @Html.ActionLink("Registrar el primer usuario", "CrearUsuario", null, new { @class = "btn btn-success" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto-ocultar las alertas después de 5 segundos
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Tooltip para los botones
            $('[title]').tooltip();
        });
    </script>
}